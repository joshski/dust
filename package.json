{
  "name": "@joshski/dust",
  "version": "0.1.67",
  "description": "Flow state for AI coding agents",
  "type": "module",
  "bin": {
    "dust": "./dist/dust.js"
  },
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./logging": {
      "import": "./dist/logging.js",
      "types": "./dist/logging/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents.js",
      "types": "./dist/agents/detection.d.ts"
    },
    "./artifacts": {
      "import": "./dist/artifacts.js",
      "types": "./dist/artifacts/index.d.ts"
    },
    "./audits": {
      "import": "./dist/audits.js",
      "types": "./dist/audits/index.d.ts"
    },
    "./filesystem": {
      "types": "./dist/filesystem/types.d.ts"
    },
    "./istanbul/minimal-reporter": "./lib/istanbul/minimal-reporter.cjs",
    "./biome": {
      "import": "./dist/biome.js",
      "types": "./dist/biome/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "lib/istanbul/minimal-reporter.cjs",
    "biome"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshski/dust.git"
  },
  "keywords": [
    "ai",
    "planning",
    "collaboration",
    "cli"
  ],
  "author": "joshski",
  "license": "MIT",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "bun run ./evals/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.6",
    "@vitest/coverage-v8": "^4.0.18",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "knip": "^5.60.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
