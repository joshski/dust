#!/bin/sh
# Output a prompt by name from the prompts/ directory

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROMPTS_DIR="$(cd "$SCRIPT_DIR/../prompts" && pwd)"

if [ -z "$1" ]; then
    echo "Usage: prompt <name>" >&2
    echo "Example: prompt work" >&2
    exit 1
fi

PROMPT_NAME="$1"
PROMPT_FILE="$PROMPTS_DIR/$PROMPT_NAME.md"

if [ ! -f "$PROMPT_FILE" ]; then
    echo "Error: Prompt '$PROMPT_NAME' not found" >&2
    echo "Available prompts:" >&2
    for f in "$PROMPTS_DIR"/*.md; do
        if [ -f "$f" ]; then
            basename "$f" .md >&2
        fi
    done
    exit 1
fi

cat "$PROMPT_FILE"
