#!/usr/bin/env bun

/**
 * dust - Unified CLI for Dust planning system
 *
 * Commands:
 *   init              Initialize a new Dust repository
 *   prompt <name>     Output a prompt by name
 *   validate          Run validation checks
 *   list [type]       List tasks, ideas, goals, or facts
 */

import { existsSync } from "node:fs";
import { readFile, writeFile, mkdir, readdir } from "node:fs/promises";
import type { CommandContext, FileSystem } from "../lib/cli/types";
import { init } from "../lib/cli/init";
import { prompt } from "../lib/cli/prompt";
import { validate, type GlobScanner } from "../lib/cli/validate";
import { list } from "../lib/cli/list";

const COMMANDS = ["init", "prompt", "validate", "list", "help"];

const nodeFs: FileSystem = {
  exists: existsSync,
  readFile: (path: string) => readFile(path, "utf-8"),
  writeFile: (path: string, content: string) => writeFile(path, content, "utf-8"),
  mkdir: (path: string, options?: { recursive?: boolean }) => mkdir(path, options),
  readdir: (path: string) => readdir(path),
};

const bunGlob: GlobScanner = {
  scan: (dir: string) => {
    const glob = new Bun.Glob("**/*.md");
    return glob.scan(dir);
  },
};

function createContext(): CommandContext {
  return {
    cwd: process.cwd(),
    stdout: (msg: string) => console.log(msg),
    stderr: (msg: string) => console.error(msg),
  };
}

function showHelp(): void {
  console.log(`dust - A lightweight planning system for human-AI collaboration

Usage: dust <command> [options]

Commands:
  init              Initialize a new Dust repository
  prompt <name>     Output a prompt by name (e.g., dust prompt work)
  validate          Run validation checks on .dust/ files
  list [type]       List items (tasks, ideas, goals, facts)
  help              Show this help message

Examples:
  dust init
  dust prompt work
  dust validate
  dust list tasks
  dust list
`);
}

async function main(): Promise<void> {
  const args = process.argv.slice(2);
  const command = args[0];
  const commandArgs = args.slice(1);
  const ctx = createContext();

  if (!command || command === "help" || command === "--help" || command === "-h") {
    showHelp();
    process.exit(0);
  }

  if (!COMMANDS.includes(command)) {
    console.error(`Unknown command: ${command}`);
    console.error(`Run 'dust help' for available commands`);
    process.exit(1);
  }

  let result;

  switch (command) {
    case "init":
      result = await init(ctx, nodeFs, commandArgs);
      break;
    case "prompt":
      result = await prompt(ctx, nodeFs, commandArgs);
      break;
    case "validate":
      result = await validate(ctx, nodeFs, commandArgs, bunGlob);
      break;
    case "list":
      result = await list(ctx, nodeFs, commandArgs);
      break;
    default:
      showHelp();
      process.exit(0);
  }

  process.exit(result.exitCode);
}

main();
