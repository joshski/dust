#!/bin/bash
# Dust quality gate - runs all checks before committing
# Note: `dust validate` runs automatically before this hook

set -e  # Exit on first failure

echo "Running quality checks..."
echo ""

echo "1. Verifying build is current..."
BEFORE_HASH=$(cat dist/* 2>/dev/null | sha256sum | cut -d' ' -f1)
bun run build
AFTER_HASH=$(cat dist/* 2>/dev/null | sha256sum | cut -d' ' -f1)
if [ "$BEFORE_HASH" != "$AFTER_HASH" ]; then
  echo ""
  echo "ERROR: Build output differs from existing dist/ files."
  echo "This means dist/ was out of sync with the TypeScript source."
  echo ""
  echo "The build has now updated dist/. Please include these changes in your commit."
  exit 1
fi
echo "   Build verified."

echo ""
echo "2. Running unit tests..."
bun run test:coverage

echo ""
echo "3. Type checking..."
bunx tsc --noEmit --skipLibCheck --module esnext --moduleResolution bundler --target esnext lib/**/*.ts

echo ""
echo "All checks passed!"
