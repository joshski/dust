{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": [
    "lib/workflow-tasks.ts",
    "lib/cli/types.ts",
    "lib/filesystem/types.ts",
    "lib/types.ts",
    "lib/logging/index.ts",
    "lib/agents/detection.ts",
    "lib/ideas.ts",
    "lib/markdown/markdown-utilities.ts",
    "lib/artifacts/index.ts",
    "lib/audits/index.ts",
    "lib/biome/index.ts"
  ]
}
